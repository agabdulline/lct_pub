# Скопировать в infra/.env. Порты на хосте — нестандартные: 5432, 6379, 8000, 5173 часто заняты.
# У каждого worktree свой стенд: своё имя проекта и свой блок портов (docs/PLAN.md, «Как работаем до сдачи»).
COMPOSE_PROJECT_NAME=lct
POSTGRES_USER=lct
POSTGRES_PASSWORD=lct
POSTGRES_DB=lct
# Роль только на чтение для ml-service (D2); без переменной — lct_ml_dev, на проде — случайный
# ML_DB_PASSWORD=
POSTGRES_PORT=15432
# Память PostgreSQL: на машине разработчика несколько стендов делят память Docker; на сервере — поднять
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_MAINTENANCE_WORK_MEM=256MB
# Свойства каналов в адресном пространстве эмулятора: false экономит ~310 МБ на стенд; на сервере — true
EMULATOR_CHANNEL_PROPERTIES=false
REDIS_PORT=16379
API_PORT=18000
ML_SERVICE_PORT=18010
WEB_PORT=18080
WEB_DEV_PORT=15173

# Локально миграции применяются при старте api; на проде — false, миграции вручную и по разрешению (DEPLOY.md)
AUTO_MIGRATE=true
TIMEZONE=Europe/Moscow
